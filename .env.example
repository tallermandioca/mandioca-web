# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres access for migrations/seeds (Project Settings → Database → Connection string, session pooler)
SUPABASE_DB_HOST=aws-1-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<ref>
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=

# Public site URL (used in emails, QR labels and wa.me links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 4+
RESEND_API_KEY=
CRON_SECRET=

# Mostrar "Continuar con Google" en /ingreso (1 cuando el proveedor Google está configurado en Supabase)
NEXT_PUBLIC_GOOGLE_AUTH=0
